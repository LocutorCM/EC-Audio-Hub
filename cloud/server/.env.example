# Copy to .env and replace every value. Never commit your real .env.
JWT_SECRET=replace-with-at-least-48-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=ec-audio-accounts
MAX_UPLOAD_GB=2

# Ko-fi: crea este nivel mensual con precio mínimo de 1 USD.
KOFI_PAGE_URL=https://ko-fi.com/ecaudio
KOFI_VERIFICATION_TOKEN=configure-in-render-only
KOFI_MONTHLY_TIER_NAME=EC Audio $1
KOFI_MONTHLY_AMOUNT=1
KOFI_CURRENCY=USD

CORS_ORIGINS=https://locutorcm.github.io
