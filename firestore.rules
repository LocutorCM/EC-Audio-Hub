rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /ecAudioSubscriptions/{uid} {
      // Each Firebase account can read only its own entitlement.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;

      // A demo can be created once. Its start time must be the trusted
      // Firestore server timestamp, so clients cannot extend the trial.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'status', 'plan', 'startedAt', 'trialUsed'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'status', 'plan', 'startedAt', 'trialUsed'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.status == 'active'
        && request.resource.data.plan == 'trial'
        && request.resource.data.trialUsed == true
        && request.resource.data.startedAt == request.time;

      // Never let a client extend, reset, or delete a previously used trial.
      allow update, delete: if false;
    }
  }
}
